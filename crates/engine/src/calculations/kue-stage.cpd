'KUE Windkraftgetriebe - Berechnung aller Stufen, CAD nur erste Stufe
'Angabe_KUE_Teil_II_WS2023_2024.pdf, Seiten 6-10
'Windkraft- und Aufbauvariante werden laut Angabe getrennt zugeteilt
Variante = 1
#if Variante ≡ 1
P_Rotor = 1000kW
n_Rotor = 22/min
n_Generator_Ziel = 1000/min
eta_1 = 0.995
eta_2 = 0.99
eta_SS = 0.975
i_SS = 0.34
#end if
#if Variante ≡ 2
P_Rotor = 500kW
n_Rotor = 30/min
n_Generator_Ziel = 1200/min
eta_1 = 0.995
eta_2 = 0.99
eta_SS = 0.97
i_SS = 0.35
#end if
#if Variante ≡ 3
P_Rotor = 300kW
n_Rotor = 40/min
n_Generator_Ziel = 1500/min
eta_1 = 0.99
eta_2 = 0.98
eta_SS = 0.965
i_SS = 0.36
#end if
#if Variante ≡ 4
P_Rotor = 100kW
n_Rotor = 60/min
n_Generator_Ziel = 1800/min
eta_1 = 0.99
eta_2 = 0.98
eta_SS = 0.96
i_SS = 0.38
#end if
'Aufbauvariante unabhaengig von der Windkraftvariante
Aufbauvariante = 1
#if Aufbauvariante ≡ 1
mode_1 = 1
mode_2 = 1
#end if
#if Aufbauvariante ≡ 2
mode_1 = 1
mode_2 = 2
#end if
#if Aufbauvariante ≡ 3
mode_1 = 2
mode_2 = 1
#end if
#if Aufbauvariante ≡ 4
mode_1 = 2
mode_2 = 2
#end if
'T_in direkt fuer eigene Drehmomentlastfaelle ersetzbar
K_A = 1.1
n_in = n_Rotor
T_in = K_A*P_Rotor/(2*pi*n_in)
R_Ziel = 3.4
z_s = 30
z_s2 = 30
n_Planeten = 3
alpha_grad = 20
breitenfaktor = 15
'Vorauslegung, kein ISO-6336-Festigkeitsnachweis; konservative Lastaufteilung
sigma_F_zul = 160N/mm^2
Y_F = 0.30
K_gamma = 1.25
sigma_Bolzen_zul = 200N/mm^2
tau_Welle_zul = 60N/mm^2
E_Stahl = 210000N/mm^2
delta_Bolzen_zul = 0.04mm
theta_Bolzen_zul = 0.005
'Verzahnung: ungeaendertes Bezugsprofil, gerade Zaehne; ganzzahlige Montagebedingung
offset_1 = 3-mode_1
offset_2 = 3-mode_2
Montagerest_1 = 3*ceiling(z_s/3)-z_s
z_p = Montagerest_1+3*round((z_s*(R_Ziel-offset_1)/2-Montagerest_1)/3)
z_r = z_s+2*z_p
R_1 = offset_1+2*z_p/z_s
#if abs(R_1-round(R_1)) < 0.000001
z_p = z_p-3
z_r = z_s+2*z_p
R_1 = offset_1+2*z_p/z_s
#end if
R_2_Ziel = n_Generator_Ziel/n_in*i_SS/R_1
Montagerest_2 = 3*ceiling(z_s2/3)-z_s2
z_p2 = Montagerest_2+3*round((z_s2*(R_2_Ziel-offset_2)/2-Montagerest_2)/3)
z_r2 = z_s2+2*z_p2
R_2 = offset_2+2*z_p2/z_s2
#if abs(R_2-round(R_2)) < 0.000001
#if R_2_Ziel > R_2
z_p2 = z_p2+3
#else
z_p2 = z_p2-3
#end if
z_r2 = z_s2+2*z_p2
R_2 = offset_2+2*z_p2/z_s2
#end if
i_1 = 1/R_1
i_2 = 1/R_2
i_gesamt = i_1*i_2*i_SS
Drehsinn_1 = 3-2*mode_1
Drehsinn_2 = 3-2*mode_2
n_1 = n_in*R_1*Drehsinn_1
n_2 = n_1*R_2*Drehsinn_2
n_Generator = n_2/i_SS
Drehzahlabweichung = abs(n_Generator)/n_Generator_Ziel-1
P_Eingang = T_in*2*pi*n_in
P_1 = P_Eingang*eta_1
P_2 = P_1*eta_2
P_Generator = P_2*eta_SS
T_1 = T_in*eta_1/(R_1*Drehsinn_1)
T_2 = T_1*eta_2/(R_2*Drehsinn_2)
T_Generator = T_2*eta_SS*i_SS
'Einfaches Zahnfussmodell Ft/(b*m*Y_F); keine Hertz-/Ermuedungsfreigabe
T_Sonne_Auslegung = T_in/R_1
modul_min = (2*K_gamma*T_Sonne_Auslegung/(n_Planeten*z_s*breitenfaktor*Y_F*sigma_F_zul))^(1/3)
'Bevorzugte Modulliste; manuelle Wahl bleibt moeglich
modul_auto = 200mm
#if modul_min ≤ 100mm
modul_auto = 100mm
#end if
#if modul_min ≤ 80mm
modul_auto = 80mm
#end if
#if modul_min ≤ 63mm
modul_auto = 63mm
#end if
#if modul_min ≤ 50mm
modul_auto = 50mm
#end if
#if modul_min ≤ 40mm
modul_auto = 40mm
#end if
#if modul_min ≤ 32mm
modul_auto = 32mm
#end if
