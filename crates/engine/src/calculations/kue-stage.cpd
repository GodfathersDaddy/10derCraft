modul_auto = 25mm
#end if
#if modul_min ≤ 20mm
modul_auto = 20mm
#end if
#if modul_min ≤ 16mm
modul_auto = 16mm
#end if
#if modul_min ≤ 12mm
modul_auto = 12mm
#end if
#if modul_min ≤ 10mm
modul_auto = 10mm
#end if
#if modul_min ≤ 8mm
modul_auto = 8mm
#end if
#if modul_min ≤ 6mm
modul_auto = 6mm
#end if
#if modul_min ≤ 5mm
modul_auto = 5mm
#end if
#if modul_min ≤ 4mm
modul_auto = 4mm
#end if
#if modul_min ≤ 3mm
modul_auto = 3mm
#end if
#if modul_min ≤ 2.5mm
modul_auto = 2.5mm
#end if
#if modul_min ≤ 2mm
modul_auto = 2mm
#end if
#if modul_min ≤ 1.5mm
modul_auto = 1.5mm
#end if
#if modul_min ≤ 1.25mm
modul_auto = 1.25mm
#end if
#if modul_min ≤ 1mm
modul_auto = 1mm
#end if
#if modul_min ≤ 0.8mm
modul_auto = 0.8mm
#end if
#if modul_min ≤ 0.6mm
modul_auto = 0.6mm
#end if
#if modul_min ≤ 0.5mm
modul_auto = 0.5mm
#end if
modul = modul_auto
modul2_min = (2*K_gamma*abs(T_1/R_2)/(n_Planeten*z_s2*breitenfaktor*Y_F*sigma_F_zul))^(1/3)
'Bevorzugte Modulliste; manuelle Wahl bleibt moeglich
modul2_auto = 200mm
#if modul2_min ≤ 100mm
modul2_auto = 100mm
#end if
#if modul2_min ≤ 80mm
modul2_auto = 80mm
#end if
#if modul2_min ≤ 63mm
modul2_auto = 63mm
#end if
#if modul2_min ≤ 50mm
modul2_auto = 50mm
#end if
#if modul2_min ≤ 40mm
modul2_auto = 40mm
#end if
#if modul2_min ≤ 32mm
modul2_auto = 32mm
#end if
#if modul2_min ≤ 25mm
modul2_auto = 25mm
#end if
#if modul2_min ≤ 20mm
modul2_auto = 20mm
#end if
#if modul2_min ≤ 16mm
modul2_auto = 16mm
#end if
#if modul2_min ≤ 12mm
modul2_auto = 12mm
#end if
#if modul2_min ≤ 10mm
modul2_auto = 10mm
#end if
#if modul2_min ≤ 8mm
modul2_auto = 8mm
#end if
#if modul2_min ≤ 6mm
modul2_auto = 6mm
#end if
