modul2_auto = 5mm
#end if
#if modul2_min ≤ 4mm
modul2_auto = 4mm
#end if
#if modul2_min ≤ 3mm
modul2_auto = 3mm
#end if
#if modul2_min ≤ 2.5mm
modul2_auto = 2.5mm
#end if
#if modul2_min ≤ 2mm
modul2_auto = 2mm
#end if
#if modul2_min ≤ 1.5mm
modul2_auto = 1.5mm
#end if
#if modul2_min ≤ 1.25mm
modul2_auto = 1.25mm
#end if
#if modul2_min ≤ 1mm
modul2_auto = 1mm
#end if
#if modul2_min ≤ 0.8mm
modul2_auto = 0.8mm
#end if
#if modul2_min ≤ 0.6mm
modul2_auto = 0.6mm
#end if
#if modul2_min ≤ 0.5mm
modul2_auto = 0.5mm
#end if
modul2 = modul2_auto
b = breitenfaktor*modul
a = modul*(z_s+z_p)/2
d_s = modul*z_s
d_p = modul*z_p
d_r = modul*z_r
F_t = 2*T_Sonne_Auslegung/(n_Planeten*d_s)
sigma_F = K_gamma*F_t/(b*modul*Y_F)
F_Bolzen = 2*K_gamma*F_t
Spiel_axial = 0.2*modul
Platte = 2*modul
Bolzenspanne = b+2*Spiel_axial+Platte
d_Bolzen_Biegung = (8*F_Bolzen*Bolzenspanne/(pi*sigma_Bolzen_zul))^(1/3)
d_Bolzen_Durchbiegung = (4*F_Bolzen*Bolzenspanne^3/(3*pi*E_Stahl*delta_Bolzen_zul))^(1/4)
d_Bolzen_Neigung = (4*F_Bolzen*Bolzenspanne^2/(pi*E_Stahl*theta_Bolzen_zul))^(1/4)
pin_r = ceiling(max(d_Bolzen_Biegung;d_Bolzen_Durchbiegung;d_Bolzen_Neigung)/2/mm)*mm
bore_p = pin_r+modul
Wand_Planet = modul*(z_p/2-1.25)-bore_p
bore_s = ceiling((16*T_Sonne_Auslegung/(pi*tau_Welle_zul))^(1/3)/2/mm)*mm
hub_r = ceiling((16*T_in/(pi*tau_Welle_zul))^(1/3)/2/mm)*mm+modul
ring_outer = modul*(z_r/2+6)
Zahnflankenspiel = 0.02*modul
Nachbarabstand = sqrt(3)*a-modul*(z_p+2)
I_Bolzen = pi*(2*pin_r)^4/64
delta_Bolzen = F_Bolzen*Bolzenspanne^3/(48*E_Stahl*I_Bolzen)
theta_Bolzen = F_Bolzen*Bolzenspanne^2/(16*E_Stahl*I_Bolzen)
sigma_Bolzen = 8*F_Bolzen*Bolzenspanne/(pi*(2*pin_r)^3)
'Alle Eingaben und Ergebnisse bleiben im CAD-Projekt; CAD erst bewusst aktualisieren

S_Zahn = sigma_F_zul/sigma_F
S_Bolzen = sigma_Bolzen_zul/sigma_Bolzen
S_Durchbiegung = delta_Bolzen_zul/delta_Bolzen
S_Neigung = theta_Bolzen_zul/theta_Bolzen
Wandreserve = Wand_Planet/modul
Montageindex = (z_s+z_r)/n_Planeten
n_eingang_rpm = n_in*min
T_eingang_Nm = T_in/(N*m)
